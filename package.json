{
  "name": "royal-turf-tabletop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --port 8789",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check:edition": "tsx scripts/check-edition.ts",
    "check:deploy": "node --import tsx scripts/check-deploy.ts",
    "deploy:api": "npm run check:deploy -- --api && wrangler deploy",
    "deploy:web": "npm run check:deploy -- --web && npm run build && npm run check:deploy -- --assets && wrangler pages deploy dist --project-name royal-turf-tabletop --branch main",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src worker scripts tests *.ts *.json *.jsonc *.md docs",
    "format:check": "prettier --check src worker scripts tests *.ts *.json *.jsonc *.md docs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "miniflare": "^4.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "^0.35.5"
  }
}
